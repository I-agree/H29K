# ==============================================================================
# 🌟 H29K OpenWrt 25.12 完整配置 RK3528 HinLink H29K
# ==============================================================================

# === 核心目标平台与设备 ===
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_h29k=y
CONFIG_TARGET_BOARD="rockchip"
CONFIG_TARGET_SUBTARGET="armv8"
CONFIG_TARGET_PROFILE="DEVICE_hinlink_h29k"

# === 分区大小 ===
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# === Bootloader ===
CONFIG_PACKAGE_u-boot-hinlink-h29k-rk3528=y

# === DNS和WiFi 认证栈 ===
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-wolfssl is not set
CONFIG_PACKAGE_wpad-openssl=y

# === LuCI 主题界面与中文化 ===
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-httpprotoutils=y

# === 防火墙 ===
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# === 5G 上网模块 ===
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_luci-i18n-qmodem-next-zh-cn=y

# === 轻量带宽监控 ===
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# === modetest DRM 底层测试支持 ===
CONFIG_PACKAGE_libdrm=y
CONFIG_PACKAGE_libdrm-tests=y

# === 基础组件 ===
# CONFIG_PACKAGE_wget-nossl is not set
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-app-wifihistory=y
CONFIG_PACKAGE_luci-i18n-wifihistory-zh-cn=y

# --- 局域网共享 (Samba) ---
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# --- 网页端一键 Overlay 扩容神器 ---
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y

# --- 硬盘/U盘全自动休眠插件 ---
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y

# === Force disable Nginx ===
# CONFIG_PACKAGE_nginx is not set
# CONFIG_PACKAGE_nginx-ssl is not set
# CONFIG_PACKAGE_nginx-mod-luci is not set
# CONFIG_PACKAGE_luci-nginx is not set
# CONFIG_PACKAGE_nginx-mod-dav-ext is not set
# CONFIG_PACKAGE_nginx-mod-headers-more is not set
# CONFIG_PACKAGE_nginx-mod-brotli is not set
# CONFIG_PACKAGE_nginx-mod-zstd is not set
