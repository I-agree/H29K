# ==============================================================================
# 🌟 H29K OpenWrt 25.12 完整配置 RK3528 HinLink H29K
# ==============================================================================

# === 核心目标平台与设备 ===
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_h29k=y
CONFIG_TARGET_BOARD="rockchip"
CONFIG_TARGET_SUBTARGET="armv8"
CONFIG_TARGET_PROFILE="DEVICE_hinlink_h29k"

# === 分区大小 ===
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# === Bootloader ===
CONFIG_PACKAGE_u-boot-hinlink-h29k-rk3528=y

# === DNS和WiFi 认证栈 ===
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-wolfssl is not set
CONFIG_PACKAGE_wpad-openssl=y

# === LuCI 主题界面与中文化 ===
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# === 防火墙 ===
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# === 5G 上网模块 ===
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_luci-i18n-qmodem-next-zh-cn=y

# === 轻量带宽监控 ===
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# === python支持 ===
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y
CONFIG_PACKAGE_python3-codecs=y
CONFIG_PACKAGE_python3-requests=y
CONFIG_PACKAGE_python3-pillow=y
CONFIG_PACKAGE_python3-numpy=y

# === modetest DRM 底层测试支持 ===
CONFIG_PACKAGE_libdrm=y
CONFIG_PACKAGE_libdrm-tests=y

# === 基础组件 ===
# CONFIG_PACKAGE_wget-nossl is not set
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
# CONFIG_PACKAGE_nftables-nojson is not set
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-i18n-filemanager-zh-cn=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_htop=y
CONFIG_IPV6=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_map=y
CONFIG_PACKAGE_ndppd=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-app-wifihistory=y
CONFIG_PACKAGE_luci-i18n-wifihistory-zh-cn=y

# --- 局域网共享 (Samba) ---
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-libs=y
CONFIG_PACKAGE_samba4-utils=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# --- 网页端一键 Overlay 扩容神器 ---
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y

# --- 硬盘/U盘全自动休眠插件 ---
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-i18n-hd-idle-zh-cn=y

# --- 基础系统运维工具 ---
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_unrar=y
CONFIG_PACKAGE_p7zip-full=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_pigz=y
CONFIG_PACKAGE_bsdtar=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_sudo=y
CONFIG_PACKAGE_shadow-utils=y
CONFIG_PACKAGE_chattr=y
CONFIG_PACKAGE_lsattr=y
CONFIG_PACKAGE_findutils=y
CONFIG_PACKAGE_logrotate=y
CONFIG_PACKAGE_chrony=y

# === 磁盘、分区、文件系统工具 ===
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_cgdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_kmod-fs-autofs4=y
CONFIG_PACKAGE_libfuse3=y
CONFIG_PACKAGE_sshfs=y
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_cifs-utils=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_lvm2=y
CONFIG_PACKAGE_nbd=y

# === 网络基础诊断工具 ===
CONFIG_PACKAGE_ipcalc=y
CONFIG_PACKAGE_bind-tools=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_mtr-json=y
CONFIG_PACKAGE_wakeonlan=y
CONFIG_PACKAGE_etherwake=y

# === 多媒体 DLNA / AirPlay / 流媒体 ===
CONFIG_PACKAGE_minidlna=y
CONFIG_PACKAGE_luci-app-minidlna=y
CONFIG_PACKAGE_luci-i18n-minidlna-zh-cn=y
CONFIG_PACKAGE_shairport-sync-openssl=y
CONFIG_PACKAGE_go2rtc=y
CONFIG_PACKAGE_ffmpeg=y

# === Force disable Nginx ===
# CONFIG_PACKAGE_nginx is not set
# CONFIG_PACKAGE_nginx-ssl is not set
# CONFIG_PACKAGE_nginx-mod-luci is not set
# CONFIG_PACKAGE_luci-nginx is not set
# CONFIG_PACKAGE_nginx-mod-dav-ext is not set
# CONFIG_PACKAGE_nginx-mod-headers-more is not set
# CONFIG_PACKAGE_nginx-mod-brotli is not set
# CONFIG_PACKAGE_nginx-mod-zstd is not set
