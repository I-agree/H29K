CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_cifs-utils=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_lvm2=y
CONFIG_PACKAGE_nbd=y

# === 网络基础诊断工具 ===
CONFIG_PACKAGE_arp-scan=y
CONFIG_PACKAGE_ipcalc=y
CONFIG_PACKAGE_bind-tools=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_nmap-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_speedtest-go=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_tshark=y
CONFIG_PACKAGE_traceroute=y
CONFIG_PACKAGE_mtr-json=y
CONFIG_PACKAGE_wakeonlan=y
CONFIG_PACKAGE_etherwake=y

# === 多媒体 DLNA / AirPlay / 流媒体 ===
CONFIG_PACKAGE_minidlna=y
CONFIG_PACKAGE_luci-app-minidlna=y
CONFIG_PACKAGE_shairport-sync-openssl=y
CONFIG_PACKAGE_go2rtc=y
CONFIG_PACKAGE_ffmpeg=y

# === VPN 组网 ===
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-i18n-proto-wireguard-zh-cn=y

# === Force disable Nginx ===
# CONFIG_PACKAGE_nginx is not set
# CONFIG_PACKAGE_nginx-ssl is not set
# CONFIG_PACKAGE_nginx-mod-luci is not set
# CONFIG_PACKAGE_luci-nginx is not set
