#!/bin/sh /etc/rc.common
# H29K: 覆写 OpenWrt 官方 upmpdcli init
#
# 与官方版的差别：
#   1) START 从 95 改到 99 —— 必须排在 mpd(98) 之后，否则 upmpdcli 起来时
#      MPD 的 6600 端口还没监听（upmpdcli 不会自己重连，会直接退不掉）。
#   2) 加 procd_set_param respawn，异常退出能自动拉回。

START=99
USE_PROCD=1

UPMPD_BIN=/usr/bin/upmpdcli

append_arg() {
	local cfg="$1"
	local var="$2"
	local opt="$3"
	local def="$4"
	local val

	config_get val "$cfg" "$var"
	if [ -n "$val" ] || [ -n "$def" ]; then
		procd_append_param command "$opt" "${val:-$def}"
	fi
}

start_instance() {
	local cfg="$1"

	procd_open_instance
	procd_set_param command "${UPMPD_BIN}"
	append_arg "$cfg" interface "-i"
	append_arg "$cfg" mpd_host "-h"
	append_arg "$cfg" mpd_port "-p"
	append_arg "$cfg" upmpd_port "-P"
	append_arg "$cfg" config "-c"
	append_arg "$cfg" friendly_name "-f"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "upmpdcli"
}

start_service() {
	config_load upmpdcli
	config_foreach start_instance upmpdcli
}
