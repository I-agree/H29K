#!/bin/sh /etc/rc.common

START=20
STOP=10

USE_PROCD=1

DRM_DRIVER="panel-mipi-dbi-spi"
PLAYER="/usr/sbin/drm_play_arm64"

find_drm_dev() {
    for c in /sys/class/drm/card[0-9]*; do
        [ -d "$c" ] || continue
        # 跳过 card0-connector 这类子节点，只处理主 card 节点
        case "$c" in *card*-*) continue;; esac
        d=$(readlink -f "$c/device/driver" 2>/dev/null)
        # 严格匹配驱动名称
        [ "${d##*/}" = "$DRM_DRIVER" ] || continue
        n=$(basename "$c")
        if [ -e "/dev/dri/$n" ]; then
            echo "/dev/dri/$n"
            return 0
        fi
    done
    # ★ 移除了 /dev/dri/card1 的硬编码兜底，找不到就返回失败
    return 1
}

start_service() {
    [ ! -x "$PLAYER" ] && return 1

    DRM_DEV=""
    i=0
    while [ $i -lt 10 ]; do
        DRM_DEV=$(find_drm_dev) && [ -n "$DRM_DEV" ] && break
        sleep 1
        i=$((i+1))
    done

    # ★ 严格校验：找不到对应驱动的设备绝不强行启动
    [ -z "$DRM_DEV" ] && {
        logger -t bootanim "Not found DRM device for $DRM_DRIVER, abort."
        return 1
    }

    logger -t bootanim "drm_play_arm64 on $DRM_DEV"

    procd_open_instance
    procd_set_param command "$PLAYER" "$DRM_DEV"
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall drm_play_arm64 2>/dev/null
}
