config btmanager 'main'
	option enabled '1'
	# 传输方式 auto = 内核已有可用 HCI 控制器（如厂商驱动通过 SDIO 提供的蓝牙）时
	# 不再用 hciattach 挂 UART；uart = 强制走串口
	option transport 'auto'
	# 仅在 transport=uart 时生效：AIC8800 BT 的 HCI 走 UART2（rk3528 uart2m1，带 CTS）
	option uart '/dev/ttyS2'
	option baud '1500000'
	option flow 'flow'
	option type 'any'
	# 开机自动连接下面 autodev 列表里的已配对设备
	option autoconnect '1'
	option autodev ''
	# 蓝牙名称（手机搜索时显示的名字），留空用 BlueZ 默认
	option devicename ''
