# bluez-alsa 配置
#
# 修改后执行：/etc/init.d/bluealsa restart
# 注意：bluealsad 必须至少在开一个 profile，否则直接退出。

config bluealsa 'main'
	# 是否随开机启动（btmanager 里"开启蓝牙"时也会自动拉起）
	option enabled '1'

	# profile 列表，空格分隔。本机是"播放端"，只推流给耳机/音箱，所以只要 a2dp-source。
	# a2dp-sink 是反过来（本机当音箱接收手机音频），用不到就别开，省内存。
	option profiles 'a2dp-source'

	# 日志级别：error / warning / info（编译带 debug 时还有 debug）
	option loglevel 'warning'

	# 1 = 日志进 syslog（logread 可见）；0 = 写到 stderr
	option syslog '1'

	# 追加原生参数（空格分隔，值里不要带引号），例如：
	#   option extra_args '-i hci0'
	option extra_args ''
