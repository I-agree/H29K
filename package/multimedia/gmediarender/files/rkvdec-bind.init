#!/bin/sh /etc/rc.common

# rkvdec 开机开闸（H29K / RK3528）
#
# 背景：999-rkvdec-gate-probe.patch 让 rkvdec 在 probe 时停在 bind_stage=0（不绑定），
#       这样可以避免 rk_iommu 在 vdec 电源域上电前裸写 MMU 寄存器、进而 FORCE_RESET 超时。
#       但代价是开机后 /dev/video0 不存在：gst 的 v4l2codecs 插件在 plugin_init 里会扫
#       /dev/video*、逐个 VIDIOC_QUERYCAP 找 stateless MM2M 设备，找不到就一个元素都不注册
#       → v4l2slh264dec / v4l2slh265dec 凭空"消失" → playbin 静默回落 avdec_h264 软解。
#
# 本脚本在启动后期把闸打开，并清掉 GStreamer registry 缓存（缓存里存的是"无硬解元素"
# 那份扫描结果，不清的话即使设备出现了也不会重新探测）。
#
# 顺序说明：START=95 必须早于 gmediarender 的 START=97，否则 gmediarender 先起、
# 拿到的仍是软解元素表。

START=95
STOP=10

start() {
	[ -e /sys/module/rockchip_vdec/parameters/bind_stage ] || return 0
	[ -e /sys/bus/platform/drivers/rkvdec/bind ] || return 0

	# 等 iommu / 电源域 / clock 就绪（实测开机 2s 后稳定）
	sleep 2

	echo 5 > /sys/module/rockchip_vdec/parameters/bind_stage 2>/dev/null
	echo ff740000.video-codec > /sys/bus/platform/drivers/rkvdec/bind 2>/dev/null

	sleep 1

	if [ -e /dev/video0 ]; then
		rm -f /root/.cache/gstreamer-1.0/registry.*.bin
		rm -f /tmp/.cache/gstreamer-1.0/registry.*.bin
		logger -t rkvdec-bind "rkvdec bound, /dev/video0 ready"
	else
		logger -t rkvdec-bind "rkvdec bind failed, decode will fall back to software"
	fi
}

stop() {
	return 0
}
