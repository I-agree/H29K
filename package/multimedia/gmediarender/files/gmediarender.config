
# gmediarender (UPnP/DLNA 渲染器) 默认配置 — H29K / RK3528 / 仅 HDMI 输出
#
# 修改后执行：/etc/init.d/gmediarender restart
# 详细说明见 package/multimedia/gmediarender/README.md

config gmediarender 'main'
	# 是否随开机启动
	option enabled '1'

	# 在 UPnP 控制器里显示的名字（手机投屏时看到的设备名）
	option friendly_name 'H29K 投屏'

	# UPnP 的设备 UUID，留空则自动用第一块网卡 MAC 生成（同一设备保持不变）
	option uuid ''

	# 绑定的网络接口。H29K 的 LAN 是 br-lan（192.168.1.1），手机一般连这个口
	option interface 'br-lan'

	# 监听端口，取值范围 49152-65535
	option port '49494'

	# 音频：本机只有 HDMI 一张声卡（card0 = rockchiphdmi），本渲染器的声音只从 HDMI 出。
	# plughw:0,0 会做格式/采样率转换，比 hw:0,0 稳；若某个老电视只吃 hw，可改 hw:0,0
	#
	# 双渲染器分工：蓝牙耳机/音箱听歌由 MPD 独占 bluealsa，投送列表里叫“H29K 投音”；
	# 本渲染器（H29K 投屏）只做 HDMI 画面+声音，不支持蓝牙音频。
	# 这里即使写成 bluealsa，init 也会强制改回 plughw:0,0 并记日志。
	option audiosink 'alsasink'
	option audiodevice 'plughw:0,0'

	# 视频输出：'auto' = 按 HDMI 实际状态自动选：
	#   检测 /sys/class/drm/card0-HDMI-A-1/status == connected 且 modes 非空
	#     → kmssink（画面直上 DRM 平面，需要 kmssink 补丁，已含在包里）
	#   否则（没接屏 / 屏没握手）
	#     → fakesink（视频帧直接丢弃，音频照常走 audiodevice）
	# 为什么必须自适应：kmssink 在没有 connected 且 modes 非空的 connector 时会以
	# "driver does not provide mode settings configuration" 失败，整个 UPnP
	# 会话被判 704，画面和声音一起没有。写成 fakesink 后，手机误投视频也
	# 只是不出画面，声音（蓝牙/HDMI）不受影响。
	#
	# 也可以写死：'kmssink'（无屏时 init 会自动降级为 fakesink 并记日志）、
	# 'fakesink'（纯听歌，永不尝试出图）、'autovideosink'（按 rank 选）。
	option videosink 'auto'

	# 需要更细控制时用整条视频管线。videopipe 非空时**优先于 videosink 生效**
	# （init 脚本里二者二选一），适合下面这种协商兜底场景。
	#
	# 【硬解兜底】v4l2slh264dec / v4l2slh265dec 输出 video/x-raw(memory:DMABuf)，
	# kmssink 一般能直接导入；若播放日志报 not-negotiated、画面黑屏，说明
	# 这条 DMABuf 路径没谈成，改用 videoconvert 走一次内存拷贝即可出图：
	#   option videopipe 'videoconvert ! kmssink device=/dev/dri/card0'
	# 需要配套 gst1-mod-videoconvertscale（CONFIG_PACKAGE_gst1-mod-videoconvertscale=y）。
	#
	# 电视只支持固定分辨率时可以先缩放到它支持的模式：
	#   option videopipe 'videoconvert ! videoscale ! video/x-raw,width=1920,height=1080 ! kmssink'
	option videopipe ''

	# 初始音量（dB）。包里 0002 补丁把 UPnP 音量接管到真正的 volume 元素上，
	# 数字增益现在是真的生效了，所以 0 就是满幅输出。
	# 本机实测：蓝牙耳机侧 AVRCP 音量固定 127（满档、不可由主机下调），叠加
	# 满幅数字增益会非常吓人；-40 dB 才是这台设备上舒服的默认值。
	# 参考：0 = 满幅、-6 ≈ 0.50、-12 ≈ 0.25、-20 ≈ 0.10、-40 ≈ 0.01
	# 接 HDMI 出电视时可按需调高（电视自身音量也可调）；投送端发 SetVolume
	# 会覆盖该初始值。
	option initial_volume_db '-40'

	# 网络缓冲（秒）。投送端是手机通过 WiFi 提供 HTTP 流，缓冲能吸收短时抖动，
	# 减少换曲、切歌时的断续/卡顿。0 = 关闭（延迟最低，完全依赖链路稳定）。
	# 实测 1 秒已能消除断续，0.5 秒仍在可接受范围且首播更快，故默认 0.5。
	option buffer_duration '0.5'

	# 媒体类型过滤：留空 = 音频+视频都接受；
	# 只做音频渲染可设 'audio'，禁用 FLAC 可设 '-audio/x-flac'
	# 注意：这是对"自动扫描结果"做增减，只能按 MIME 增删，管不到容器里的编码。
	option mime_filter ''

	# ── DLNA 能力通告（ConnectionManager 的 SinkProtocolInfo）────────────────
	# 留空 = 用 GStreamer 自动扫描的全量 MIME。它会把 video/x-vp9、video/x-av1、
	#        video/x-theora 这些本机解不了的格式一并通告出去，控制器就会照推，
	#        结果是黑屏/卡死（RK3528 硬件里根本没有 VP9/AV1 解码器）。
	#
	# 非空 = 严格白名单，直接替换自动扫描结果，只通告这里列出的 MIME。
	# 手机端/投屏 App 看到不支持，会自己转码或选别的流，体验反而更好。
	#
	# 默认值 = H.264/HEVC 常见容器 + 能实时解开的音频：
	#   MP4/MOV、MKV、MPEG-PS、TS、AVI；AAC、MP3、FLAC、Vorbis、Opus、PCM
	# 想放开某个格式（例如允许 webm），把对应 MIME 追加进来即可；
	# 想更严，只留 'video/mp4,video/x-matroska,audio/mpeg,audio/mp4' 也行。
	option sink_whitelist 'video/mp4,video/quicktime,video/x-matroska,video/mpeg,video/mp2t,video/mpegts,video/x-msvideo,video/avi,audio/mpeg,audio/x-mpeg,audio/mp4,audio/x-m4a,audio/m4a,audio/aac,audio/x-aac,audio/flac,audio/x-flac,audio/x-wav,audio/wav,audio/x-vorbis,audio/vorbis,audio/opus,audio/x-opus,audio/L16;rate=44100;channels=2'

	# 调试日志，例如 '/tmp/gmediarender.log'；留空不写日志
	option logfile ''

	# 追加命令行参数（空格分隔，值里不要带引号）
	option extra_args ''
