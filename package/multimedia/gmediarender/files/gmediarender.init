#!/bin/sh /etc/rc.common

# gmediarender — UPnP/DLNA 渲染器 procd 启动脚本
#
# 注意：gmediarender 自带 -d（daemonize）选项，procd 下不能使用，
#       否则父进程退出、procd 会不断重启；本脚本让它在前台常驻。

START=97
STOP=10
USE_PROCD=1

PROG=/usr/bin/gmediarender
CONFIG_NAME=gmediarender

# 没配置 uuid 时，用第一块物理网卡的 MAC 生成一个稳定的 UUID
derive_uuid() {
	local iface="$1" mac="" i

	if [ -z "$iface" ]; then
		for i in /sys/class/net/*; do
			[ -e "$i/device" ] || continue
			iface="${i##*/}"
			break
		done
	fi

	[ -n "$iface" ] && mac="$(cat "/sys/class/net/$iface/address" 2>/dev/null)"
	[ -n "$mac" ] || mac="$(cat /etc/machine-id 2>/dev/null)"
	[ -n "$mac" ] || mac="openwrt"

	printf '%s' "$mac" | md5sum | awk '{print $1}'
}

start_instance() {
	local section="$1"
	local enabled friendly_name uuid iface port audiosink audiodevice
	local videosink videopipe volume_db mime_filter logfile extra_args

	config_get_bool enabled "$section" enabled 1
	[ "$enabled" = "1" ] || return 0

	[ -x "$PROG" ] || {
		logger -t gmediarender "binary $PROG not found, skip"
		return 1
	}

	config_get friendly_name "$section" friendly_name "OpenWrt Renderer"
	config_get uuid "$section" uuid ""
	config_get iface "$section" interface ""
	config_get port "$section" port "49494"
	config_get audiosink "$section" audiosink "alsasink"
	config_get audiodevice "$section" audiodevice ""
	config_get videosink "$section" videosink ""
	config_get videopipe "$section" videopipe ""
	config_get volume_db "$section" initial_volume_db "-10"
	config_get mime_filter "$section" mime_filter ""
	config_get logfile "$section" logfile ""
	config_get extra_args "$section" extra_args ""

	[ -n "$uuid" ] || uuid="$(derive_uuid "$iface")"

	set -- "$PROG" -f "$friendly_name" -u "$uuid"
	[ -n "$iface" ] && set -- "$@" --interface-name "$iface"
	[ -n "$port" ] && set -- "$@" --port "$port"
	[ -n "$audiosink" ] && set -- "$@" --gstout-audiosink "$audiosink"
	[ -n "$audiodevice" ] && set -- "$@" --gstout-audiodevice "$audiodevice"
	# videosink 与 videopipe 二选一：videopipe 非空时优先生效（用于需要
	# videoconvert 兜底的场景），避免两个参数同时传给 gmediarender
	if [ -n "$videopipe" ]; then
		set -- "$@" --gstout-videopipe "$videopipe"
	elif [ -n "$videosink" ]; then
		set -- "$@" --gstout-videosink "$videosink"
	fi
	[ -n "$volume_db" ] && set -- "$@" --gstout-initial-volume-db "$volume_db"
	[ -n "$mime_filter" ] && set -- "$@" --mime-filter "$mime_filter"
	[ -n "$logfile" ] && set -- "$@" --logfile "$logfile"
	# extra_args 允许追加原生参数，按空格切分（值里不要带引号）
	[ -n "$extra_args" ] && set -- "$@" $extra_args

	procd_open_instance "$section"
	procd_set_param command "$@"
	procd_set_param env USER=root HOME=/root
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param file "/etc/config/$CONFIG_NAME"
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load "$CONFIG_NAME"
	config_foreach start_instance gmediarender
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG_NAME"
}
