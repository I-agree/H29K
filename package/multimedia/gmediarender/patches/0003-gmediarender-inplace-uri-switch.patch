diff --git a/src/output_gstreamer.c b/src/output_gstreamer.c
index 74babff..46b29b2 100644
--- a/src/output_gstreamer.c
+++ b/src/output_gstreamer.c
@@ -183,6 +183,13 @@ static int output_gstreamer_pause(void) {
 static int output_gstreamer_seek(gint64 position_nanos) {
 	if (gst_element_seek_simple(player_, GST_FORMAT_TIME, GST_SEEK_FLAG_FLUSH,
 								position_nanos)) {
+		/* seek 之后 pipeline 会立刻进入 preroll（PAUSED），而
+		 * output_gstreamer_get_position() 在非 PLAYING 状态下直接返回
+		 * last_known_time_。不在这里更新缓存，紧接着的 GetPositionInfo
+		 * 就会把 seek 之前的旧位置报回控制端：App 的时间轴被拖到目标后
+		 * 又被拉回原值，表现为"时间停住不动，直到自然播放追上目标"。
+		 * 这里把缓存直接对齐到 seek 目标。 */
+		last_known_time_.position = position_nanos;
 		return 0;
 	} else {
 		return -1;
@@ -536,17 +543,20 @@ static void prepare_next_stream(GstElement *obj, gpointer userdata) {
 	(void)obj;
 	(void)userdata;
 
-	Log_info("gstreamer", "about-to-finish cb: setting uri %s",
-		 gs_next_uri_);
-	free(gsuri_);
-	gsuri_ = gs_next_uri_;
-	gs_next_uri_ = NULL;
-	if (gsuri_ != NULL) {
+	/* drained 每次流结束都会触发，控制端并不总是给 next uri。
+	 * 原代码在 gs_next_uri_ 为空时也会 free(gsuri_) 并置空，
+	 * 于是每首歌放完当前 uri 就被丢掉：之后控制端若只发 Play
+	 * （复用同一个 URI）或者重发同一条，playbin 拿到的是 NULL，
+	 * 永远停在 EOS，表现为"自己停了、再点也没反应"。
+	 * 只在真的有 next uri 时才替换。 */
+	if (gs_next_uri_ != NULL) {
+		Log_info("gstreamer", "about-to-finish cb: setting uri %s",
+			 gs_next_uri_);
+		free(gsuri_);
+		gsuri_ = gs_next_uri_;
+		gs_next_uri_ = NULL;
 		g_object_set(G_OBJECT(player_), "uri", gsuri_, NULL);
 		if (play_trans_callback_) {
-			// TODO(hzeller): can we figure out when we _actually_
-			// start playing this ? there are probably a couple
-			// of seconds between now and actual start.
 			play_trans_callback_(PLAY_STARTED_NEXT_STREAM);
 		}
 	}
diff --git a/src/upnp_transport.c b/src/upnp_transport.c
index 558ff5e..42cf6c8 100644
--- a/src/upnp_transport.c
+++ b/src/upnp_transport.c
@@ -764,8 +764,11 @@ static void inform_play_transition_from_output(enum PlayFeedback fb) {
 	service_lock();
 	switch (fb) {
 	case PLAY_STOPPED:
-		replace_transport_uri_and_meta("", "");
-		replace_current_uri_and_meta("", "");
+		/* 说明：原代码在这里把 AVTransportURI 和 CurrentTrackURI 一并
+		 * 清空。UPnP AVTransport 规范里播放结束只需把 TransportState
+		 * 置 STOPPED，URI 应保留最后设置的值；清空会让部分控制端判定
+		 * "设备会话已结束"，歌尾之后不再续投，也不会再发 Play。
+		 * 这里只改状态，保留 URI，让控制端仍能对该设备继续操作。 */
 		change_transport_state(TRANSPORT_STOPPED);
 		break;
 
