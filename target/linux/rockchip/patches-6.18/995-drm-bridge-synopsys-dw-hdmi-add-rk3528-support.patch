--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -3192,6 +3192,14 @@
 	unsigned int i;
 	u8 phy_type;
 
+	/*
+	 * RK3528 uses an external Inno HDMI PHY. The internal CONFIG2_ID
+	 * register may return an unsupported type. If the platform glue
+	 * layer forces vendor PHY, skip reading the internal register.
+	 */
+	if (hdmi->plat_data->phy_force_vendor)
+		phy_type = DW_HDMI_PHY_VENDOR_PHY;
+	else
 	phy_type = hdmi->plat_data->phy_force_vendor ?
 				DW_HDMI_PHY_VENDOR_PHY :
 				hdmi_readb(hdmi, HDMI_CONFIG2_ID);
