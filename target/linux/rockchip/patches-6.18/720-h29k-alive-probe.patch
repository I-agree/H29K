+/*
+ * H29K 取证块 A：阶段记录 + 灯码原语（init/main.c）
+ *   RK3528 gpio4 @ 0xffb20000，GPIO v2（drivers/gpio/gpio-rockchip.c）：
+ *     DR_L 0x00 / DR_H 0x04 / DDR_L 0x08 / DDR_H 0x0c
+ *   高半区写入语义：writel((值 & 0xffff) | 0xffff0000, reg)
+ *   red:4g  = gpio4 RK_PC0 -> DR_H bit0，blue:5g = gpio4 RK_PC3 -> DR_H bit3，低电平点亮
+ */
+#define H29K_ALIVE_SECS		240
+#define H29K_GPIO4_BASE		0xffb20000
+#define H29K_GPIO4_SIZE		0x20
+#define H29K_DRH_OFF		0x04
+#define H29K_DDRH_OFF		0x0c
+#define H29K_LED_RED_BIT	0
+#define H29K_LED_BLUE_BIT	3
+#define H29K_LED_BITS		(BIT(H29K_LED_RED_BIT) | BIT(H29K_LED_BLUE_BIT))
+
+static int h29k_stage = 1;	/* 1 = 还在 do_initcalls 内部；2 = initcalls 已走完 */
+static int h29k_level;		/* 当前 initcall level 0..7 */
+static int h29k_idx;		/* 当前 level 内的序号，1 起 */
+static void __iomem *h29k_gpio4;
+static struct timer_list h29k_alive_timer;
+
+/*
+ * 供 drivers/base/dd.c 调用：那边用 extern 声明，这里必须给一个前置原型，
+ * 否则 -Wmissing-prototypes（内核 -Werror）会直接失败。
+ */
+void h29k_blink_code(int a, int b);
+
+static u32 h29k_drh_read(void)
+{
+	return readl(h29k_gpio4 + H29K_DRH_OFF) & 0xffff;
+}
+
+static void h29k_drh_write(u32 v)
+{
+	writel((v & 0xffff) | 0xffff0000, h29k_gpio4 + H29K_DRH_OFF);
+}
+
+/* 软中断上下文用（mdelay）；两灯同亮/全灭交替一拍 */
+static void h29k_beat(int sym, int on_ms)
+{
+	u32 v;
+
+	if (!h29k_gpio4)
+		return;
+
+	v = h29k_drh_read();
+	v |= H29K_LED_BITS;
+	if (sym & 1)
+		v &= ~BIT(H29K_LED_RED_BIT);
+	if (sym & 2)
+		v &= ~BIT(H29K_LED_BLUE_BIT);
+	h29k_drh_write(v);
+	mdelay(on_ms);
+	h29k_drh_write(h29k_drh_read() | H29K_LED_BITS);
+	mdelay(400);
+}
+
+/* 进程上下文用（msleep）：报"第一组 a 拍、停一下、第二组 b 拍" */
+void h29k_blink_code(int a, int b)
+{
+	int i;
+
+	if (!h29k_gpio4)
+		return;
+
+	for (i = 0; i < a; i++) {
+		h29k_drh_write(h29k_drh_read() & ~H29K_LED_BITS);
+		msleep(500);
+		h29k_drh_write(h29k_drh_read() | H29K_LED_BITS);
+		msleep(400);
+	}
+	if (b > 0) {
+		msleep(2000);	/* 组间长停，方便数清两组 */
+		for (i = 0; i < b; i++) {
+			h29k_drh_write(h29k_drh_read() & ~H29K_LED_BITS);
+			msleep(500);
+			h29k_drh_write(h29k_drh_read() | H29K_LED_BITS);
+			msleep(400);
+		}
+	}
+	msleep(2000);		/* 结尾长停：这一组到此结束 */
+}
+
+static void h29k_alive_probe(struct timer_list *t)
+{
+	int i, v;
+
+	pr_emerg("H29K probe: stage=%d level=%d idx=%d\n",
+		 h29k_stage, h29k_level, h29k_idx);
+
+	if (!h29k_gpio4) {
+		panic("H29K alive probe: gpio4 ioremap failed, alive at %d s",
+		      H29K_ALIVE_SECS);
+		return;
+	}
+
+	if (h29k_stage != 1) {
+		/* 已过 initcalls：卡点在别处，由 drivers/base/dd.c 的灯码报 */
+		panic("H29K alive probe: still alive at %d s (stage %d)",
+		      H29K_ALIVE_SECS, h29k_stage);
+		return;
+	}
+
+	/* 第 1 拍固定红蓝同亮 = 内核还活着 */
+	h29k_beat(3, 600);
+	mdelay(1500);
+	v = h29k_level;			/* 2 拍：低 2 位、高 2 位 */
+	h29k_beat(v & 3, 600);
+	h29k_beat((v >> 2) & 3, 600);
+	mdelay(1500);
+	v = h29k_idx;			/* 5 拍：bit1:0 ... bit9:8 */
+	for (i = 0; i < 5; i++)
+		h29k_beat((v >> (2 * i)) & 3, 600);
+
+	panic("H29K alive probe: still alive at %d s (stage 1 level %d idx %d)",
+	      H29K_ALIVE_SECS, h29k_level, h29k_idx);
+}
