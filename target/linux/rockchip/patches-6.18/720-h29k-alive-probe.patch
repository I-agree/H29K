+
+/*
+ * H29K 网口状态探针：报"有没有 eth0 / 能不能 open / 有没有 link"
+ *   第一组固定 4 拍（区别于"卡死报错码" 1/2/3），第二组是状态码：
+ *     1 = 找不到 eth0（gmac 没注册：probe 失败或被禁用）
+ *     2 = 有 eth0，但 dev_open 失败
+ *     3 = open 成功且 carrier up（物理链路通，netconsole 才有戏）
+ *     4 = open 成功但 carrier 不下来（PHY/链路侧问题）
+ * 这个函数只在 prepare_namespace() 里被调用：此时所有 initcall（含 late_initcall 的
+ * netconsole）都已跑过，carrier 也已有充分时间协商。
+ */
+static void h29k_netprobe(void)
+{
+	struct net_device *ndev;
+	int code;
+	int i, err = 0;
+
+	rtnl_lock();
+	ndev = __dev_get_by_name(&init_net, "eth0");
+	if (!ndev) {
+		rtnl_unlock();
+		pr_emerg("H29K netprobe: eth0 not found (gmac 未注册)\n");
+		h29k_blink_code(4, 1);
+		return;
+	}
+
+	/* rtnl 下拿一个引用，保证放锁等 carrier 期间设备不被释放（netpoll 同款做法） */
+	dev_hold(ndev);
+
+	if (netif_running(ndev)) {
+		code = netif_carrier_ok(ndev) ? 3 : 4;
+	} else {
+		err = dev_open(ndev, NULL);
+		if (err) {
+			code = 2;
+		} else {
+			/* rtnl 不能拿着睡，按 netpoll 的写法放锁等 carrier，再收回 */
+			rtnl_unlock();
+			for (i = 0; i < 40; i++) {
+				if (netif_carrier_ok(ndev))
+					break;
+				msleep(100);
+			}
+			rtnl_lock();
+			code = netif_carrier_ok(ndev) ? 3 : 4;
+		}
+	}
+
+	pr_emerg("H29K netprobe: dev=%s running=%d carrier=%d open_err=%d code=%d\n",
+		 ndev->name, netif_running(ndev), netif_carrier_ok(ndev), err, code);
+	rtnl_unlock();
+	dev_put(ndev);
+
+	h29k_blink_code(4, code);
+}
