 void wait_for_device_probe(void)
 {
-	/* wait for the deferred probe workqueue to finish */
-	flush_work(&deferred_probe_work);
+	int i, stage = 0;
 
-	/* wait for the known devices to complete their probing */
-	wait_event(probe_waitqueue, atomic_read(&probe_count) == 0);
-	async_synchronize_full();
+	/*
+	 * H29K 取证：原版这里是无界等待，任何一个 probe 不返回就永久卡死
+	 * （典型形态：do_initcalls() 全部返回、rootfs 从未被挂载、无用户态、无日志）。
+	 * 这里改成有界，并在超时后用 printk + 灯码把"谁挂住了 probe"报出来，然后放行继续启动。
+	 */
+
+	/* A：deferred_probe_work 是否收尾（有界轮询，最多 15 s） */
+	for (i = 0; i < 300; i++) {
+		if (!work_pending(&deferred_probe_work) &&
+		    !work_busy(&deferred_probe_work))
+			break;
+		msleep(50);
+	}
+	if (i == 300)
+		stage = 1;
+
+	/* B：probe_count 是否归零（有界等待，最多 20 s） */
+	if (!stage &&
+	    !wait_event_timeout(probe_waitqueue,
+				atomic_read(&probe_count) == 0, 20 * HZ))
+		stage = 2;
+
+	if (!stage) {
+		/* 一切正常，保持原语义 */
+		async_synchronize_full();
+		return;
+	}
+
+	pr_emerg("H29K: wait_for_device_probe STUCK stage=%d probe_count=%d last_dev=%s last_drv=%s seq=%d\n",
+		 stage, atomic_read(&probe_count), h29k_cur_dev, h29k_cur_drv,
+		 atomic_read(&h29k_probe_seq));
+
+	/*
+	 * 灯码：先报卡在哪一步，再报设备类别。
+	 * 卡住的若是异步 probe，async_synchronize_full() 必然第二次挂死，这里直接跳过。
+	 */
+	h29k_blink_code(stage, h29k_probe_cat());
 }
 EXPORT_SYMBOL_GPL(wait_for_device_probe);
 
