+/*
+ * H29K 取证块 B：记录"正在 probe 的设备/驱动"
+ * 目的：wait_for_device_probe() 里的 probe_count 若永不归零，要能说出是谁把 probe 挂住了。
+ * 灯码由 init/main.c 的 h29k_blink_code(a, b) 输出：
+ *   第一组 = 卡在哪个等待（1 = deferred_probe_work，2 = probe_count）
+ *   第二组 = 设备类别（1 = 网口，2 = eMMC/SD，3 = USB，4 = 显示/视频，5 = 其他）
+ */
+static char h29k_cur_dev[64] = "none";
+static char h29k_cur_drv[64] = "none";
+static atomic_t h29k_probe_seq = ATOMIC_INIT(0);
+
+extern void h29k_blink_code(int a, int b);
+
+static void h29k_record_probe(const struct device *dev,
+			      const struct device_driver *drv)
+{
+	strscpy(h29k_cur_dev, dev_name(dev), sizeof(h29k_cur_dev));
+	if (drv && drv->name)
+		strscpy(h29k_cur_drv, drv->name, sizeof(h29k_cur_drv));
+	else if (dev->bus)
+		strscpy(h29k_cur_drv, dev->bus->name, sizeof(h29k_cur_drv));
+	else
+		strscpy(h29k_cur_drv, "none", sizeof(h29k_cur_drv));
+	atomic_inc(&h29k_probe_seq);
+}
+
+static int h29k_probe_cat(void)
+{
+	if (strstr(h29k_cur_drv, "stmmac") || strstr(h29k_cur_drv, "dwmac") ||
+	    strstr(h29k_cur_dev, "ethernet") || strstr(h29k_cur_dev, "gmac"))
+		return 1;
+	if (strstr(h29k_cur_drv, "sdhci") || strstr(h29k_cur_drv, "dwcmshc") ||
+	    strstr(h29k_cur_drv, "dw_mmc") || strstr(h29k_cur_dev, "mmc"))
+		return 2;
+	if (strstr(h29k_cur_drv, "dwc3") || strstr(h29k_cur_drv, "xhci") ||
+	    strstr(h29k_cur_drv, "usb") || strstr(h29k_cur_dev, "usb"))
+		return 3;
+	if (strstr(h29k_cur_drv, "vop") || strstr(h29k_cur_drv, "drm") ||
+	    strstr(h29k_cur_drv, "vdec") || strstr(h29k_cur_drv, "hdmi"))
+		return 4;
+	return 5;
+}
+
