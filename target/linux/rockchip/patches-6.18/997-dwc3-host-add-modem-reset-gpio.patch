+static void dwc3_modem_reset_work_fn(struct work_struct *work)
+{
+	struct dwc3 *dwc = container_of(work, struct dwc3, modem_reset_work);
+
+	if (!dwc->modem_rst_gpio)
+		return;
+
+	dev_info(dwc->dev, "FM350-GL: Triggering asynchronous HW reset...\n");
+
+	/* Pre-discharge & PHY sync wait */
+	fsleep(500000);
+
+	/* Assert reset (logical 0 = physical active level) */
+	gpiod_set_value_cansleep(dwc->modem_rst_gpio, 0);
+	fsleep(dwc->reset_assert_us);
+
+	/* Deassert reset (logical 1 = physical safe state) */
+	gpiod_set_value_cansleep(dwc->modem_rst_gpio, 1);
+
+	/* Wait for firmware boot and PHY link training */
+	msleep(DIV_ROUND_UP(dwc->reset_deassert_us, 1000));
+
+	dev_info(dwc->dev, "FM350-GL: Reset sequence completed.\n");
+}
