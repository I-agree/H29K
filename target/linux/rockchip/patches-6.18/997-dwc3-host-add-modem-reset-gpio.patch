 u32 dwc3_core_fifo_space(struct dwc3_ep *dep, u8 type)
 {
 	struct dwc3		*dwc = dep->dwc;
@@ -2337,6 +2365,36 @@
 	dwc3_check_params(dwc);
 	dwc3_debugfs_init(dwc);
 
+	/*
+	 * Modem reset GPIO & work initialization
+	 * Bound to core lifecycle to ensure pin state is maintained
+	 * during mode transitions and warm reboot.
+	 * Placed before mode init to keep EPROBE_DEFER rollback clean.
+	 */
+	{
+		dwc->reset_assert_us = 1000000;	/* Default 1s assert */
+		dwc->reset_deassert_us = 8000000;	/* Default 8s deassert */
+
+		device_property_read_u32(dev, "reset-assert-us", &dwc->reset_assert_us);
+		device_property_read_u32(dev, "reset-deassert-us", &dwc->reset_deassert_us);
+
+		/* Init work once with core lifecycle */
+		INIT_WORK(&dwc->modem_reset_work, dwc3_modem_reset_work_fn);
+
+		dwc->modem_rst_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_ASIS);
+		if (IS_ERR(dwc->modem_rst_gpio)) {
+			ret = PTR_ERR(dwc->modem_rst_gpio);
+			if (ret == -EPROBE_DEFER)
+				goto err_exit_debugfs;
+			dev_err(dev, "failed to get modem reset gpio: %d\n", ret);
+			dwc->modem_rst_gpio = NULL;
+		} else if (dwc->modem_rst_gpio) {
+			/* Drive to safe state (physical LOW) before setting output direction */
+			gpiod_set_value_cansleep(dwc->modem_rst_gpio, 1);
+			gpiod_direction_output(dwc->modem_rst_gpio, 1);
+		}
+	}
+
 	ret = dwc3_core_init_mode(dwc);
 	if (ret)
 		goto err_exit_debugfs;
