 	dwc3_debugfs_exit(dwc);
 
+	/* Safely teardown modem reset GPIO */
+	if (dwc->modem_rst_gpio) {
+		cancel_work_sync(&dwc->modem_reset_work);
+		/* Drive to physical LOW safe state before release */
+		gpiod_set_value_cansleep(dwc->modem_rst_gpio, 1);
+		dwc->modem_rst_gpio = NULL;
+	}
+
 	dwc3_core_exit(dwc);
 	dwc3_ulpi_exit(dwc);
