+static void dwc3_modem_reset_work_fn(struct work_struct *work)
+{
+	struct dwc3 *dwc = container_of(work, struct dwc3, modem_reset_work);
+
+	if (!dwc->modem_rst_gpio)
+		return;
+
+	dev_info(dwc->dev, "FM350-GL: Triggering asynchronous HW reset...\n");
+
+	/* Step 0: Pre-discharge & PHY Sync Wait. */
+	fsleep(500000);
+
+	/* Step 1: Assert reset (Logical 0 -> Physical HIGH) */
+	gpiod_set_value_cansleep(dwc->modem_rst_gpio, 0);
+	fsleep(dwc->reset_assert_us);
+
+	/* Step 2: Deassert reset (Logical 1 -> Physical LOW) */
+	gpiod_set_value_cansleep(dwc->modem_rst_gpio, 1);
+
+	/*
+	 * Step 3: Wait for firmware load and USB PHY link training.
+	 * Executed asynchronously to prevent blocking dwc3_host_init.
+	 */
+	msleep(DIV_ROUND_UP(dwc->reset_deassert_us, 1000));
+
+	dev_info(dwc->dev, "FM350-GL: Reset sequence completed.\n");
+}
+
 int dwc3_host_init(struct dwc3 *dwc)
 {
 	struct property_entry	props[6];
@@ -215,6 +245,13 @@
 		device_init_wakeup(&xhci->dev, true);
 	}
 
+	/*
+	 * Schedule the modem reset asynchronously.
+	 * This prevents blocking the dwc3_host_init return path, avoiding cold-boot hangs.
+	 */
+	INIT_WORK(&dwc->modem_reset_work, dwc3_modem_reset_work_fn);
+	schedule_work(&dwc->modem_reset_work);
+
 	return 0;
 err:
 	platform_device_put(xhci);
