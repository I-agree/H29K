--- a/drivers/usb/dwc3/host.c
+++ b/drivers/usb/dwc3/host.c
@@ -12,6 +12,9 @@
 #include <linux/platform_device.h>
 #include <linux/usb.h>
 #include <linux/usb/hcd.h>
+#include <linux/gpio/consumer.h>
+#include <linux/delay.h>
+#include <linux/workqueue.h>
 
 #include "../host/xhci-port.h"
 #include "../host/xhci-ext-caps.h"
@@ -22,6 +25,34 @@
 #define XHCI_HCSPARAMS1		0x4
 #define XHCI_PORTSC_BASE	0x400
 
+/* Context for fully asynchronous modem reset */
+struct modem_reset_ctx {
+	struct delayed_work work;
+	struct device *dev;
+	struct gpio_desc *gpio;
+	int state;
+};
+
+static void modem_async_work_handler(struct work_struct *work)
+{
+	struct modem_reset_ctx *ctx = container_of(to_delayed_work(work), struct modem_reset_ctx, work);
+
+	if (!ctx || !ctx->gpio)
+		return;
+
+	if (ctx->state == 0) {
+		/* Step 1: Assert reset (Physical LOW) */
+		gpiod_set_value_cansleep(ctx->gpio, 0);
+		ctx->state = 1;
+		/* Schedule deassert after 1 second asynchronously */
+		schedule_delayed_work(&ctx->work, msecs_to_jiffies(1000));
+	} else if (ctx->state == 1) {
+		/* Step 2: Deassert reset (Physical HIGH) */
+		gpiod_set_value_cansleep(ctx->gpio, 1);
+		dev_info(ctx->dev, "FM350-GL: Async HW reset sequence completed.\n");
+	}
+}
+
 /**
  * dwc3_power_off_all_roothub_ports - Power off all Root hub ports
  * @dwc: Pointer to our controller context structure
@@ -161,6 +192,35 @@
 		goto err;
 	}
 
+	/*
+	 * Acquire the modem reset GPIO and trigger async reset.
+	 * This avoids blocking the xHCI initialization thread entirely.
+	 */
+	{
+		struct gpio_desc *rst_gpio;
+		struct modem_reset_ctx *ctx;
+
+		rst_gpio = devm_gpiod_get_optional(dwc->dev, "reset", GPIOD_ASIS);
+		if (IS_ERR(rst_gpio)) {
+			if (PTR_ERR(rst_gpio) == -EPROBE_DEFER) {
+				ret = -EPROBE_DEFER;
+				goto err;
+			}
+			dev_err(dwc->dev, "failed to get modem reset gpio: %ld\n", PTR_ERR(rst_gpio));
+		} else if (rst_gpio) {
+			/* Set to safe state (Physical LOW) first */
+			gpiod_set_value_cansleep(rst_gpio, 1);
+
+			if (gpiod_direction_output(rst_gpio, 1) == 0) {
+				ctx = devm_kzalloc(dwc->dev, sizeof(*ctx), GFP_KERNEL);
+				if (ctx) {
+					ctx->dev = dwc->dev;
+					ctx->gpio = rst_gpio;
+					ctx->state = 0;
+					INIT_DELAYED_WORK(&ctx->work, modem_async_work_handler);
+					
+					dev_info(dwc->dev, "FM350-GL: Scheduling async HW reset...\n");
+					/* Start the async reset sequence immediately without blocking */
+					schedule_delayed_work(&ctx->work, 0);
+				}
+			}
+		}
+	}
+
 	memset(props, 0, sizeof(struct property_entry) * ARRAY_SIZE(props));
 
 	props[prop_idx++] = PROPERTY_ENTRY_BOOL("xhci-sg-trb-cache-size-quirk");
