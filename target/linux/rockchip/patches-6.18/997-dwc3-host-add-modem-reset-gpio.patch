--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -36,6 +36,9 @@
 #include <linux/usb/of.h>
 #include <linux/usb/otg.h>
 
+#include <linux/gpio/consumer.h>
+#include <linux/property.h>
+
 #include "core.h"
 #include "gadget.h"
 #include "glue.h"
@@ -2342,5 +2345,25 @@
 		goto err_exit_debugfs;
 
+	/*
+	 * CRITICAL WARM-REBOOT FIX:
+	 * Bind GPIO lifecycle to dwc3_core_probe/remove instead of host_init/exit.
+	 * This ensures the pin remains strongly driven during __dwc3_set_mode
+	 * transitions and dwc3_set_prtcap calls.
+	 */
+	dwc->reset_assert_us = 1000000;    /* Default 1s assert */
+	dwc->reset_deassert_us = 8000000;  /* Extended to 8s for warm-reboot dirty state clearance */
+	device_property_read_u32(dev, "reset-assert-us", &dwc->reset_assert_us);
+	device_property_read_u32(dev, "reset-deassert-us", &dwc->reset_deassert_us);
+
+	dwc->modem_rst_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(dwc->modem_rst_gpio)) {
+		ret = PTR_ERR(dwc->modem_rst_gpio);
+		if (ret == -EPROBE_DEFER)
+			goto err_exit_debugfs;
+		dev_err(dev, "failed to get modem reset gpio: %d\n", ret);
+		dwc->modem_rst_gpio = NULL;
+	}
+
 	pm_runtime_put(dev);
 
 	dma_set_max_seg_size(dev, UINT_MAX);
@@ -2405,5 +2428,13 @@
 	dwc3_core_exit_mode(dwc);
 	dwc3_debugfs_exit(dwc);
+
+	/* Safely release the devm-managed GPIO on core teardown */
+	if (dwc->modem_rst_gpio) {
+		cancel_work_sync(&dwc->modem_reset_work);
+		gpiod_set_value_cansleep(dwc->modem_rst_gpio, 1); /* Force Physical LOW safe state */
+		/* devm will automatically call gpiod_put after this function returns */
+		dwc->modem_rst_gpio = NULL;
+	}
 
 	dwc3_core_exit(dwc);
 	dwc3_ulpi_exit(dwc);
--- a/drivers/usb/dwc3/host.c
+++ b/drivers/usb/dwc3/host.c
@@ -12,6 +12,8 @@
 #include <linux/platform_device.h>
 #include <linux/usb.h>
 #include <linux/usb/hcd.h>
+#include <linux/gpio/consumer.h>
