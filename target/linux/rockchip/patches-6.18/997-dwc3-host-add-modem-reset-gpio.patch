--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1241,5 +1241,10 @@
 	struct usb_phy		*usb2_phy;
 	struct usb_phy		*usb3_phy;
 
+	/* Modem reset GPIO for FM350-GL (Non-devm managed for OTG safety) */
+	struct gpio_desc	*modem_rst_gpio;
+	u32			reset_assert_us;
+	u32			reset_deassert_us;
+
 	struct phy		*usb2_generic_phy[DWC3_USB2_MAX_PORTS];
 	struct phy		*usb3_generic_phy[DWC3_USB3_MAX_PORTS];
--- a/drivers/usb/dwc3/host.c
+++ b/drivers/usb/dwc3/host.c
@@ -12,6 +12,9 @@
 #include <linux/platform_device.h>
 #include <linux/usb.h>
 #include <linux/usb/hcd.h>
+#include <linux/gpio/consumer.h>
+#include <linux/delay.h>
+#include <linux/property.h>
 
 #include "../host/xhci-port.h"
 #include "../host/xhci-ext-caps.h"
@@ -130,11 +133,67 @@
 int dwc3_host_init(struct dwc3 *dwc)
 {
+	struct gpio_desc *modem_rst_gpio = NULL;
 	struct property_entry	props[6];
 	struct platform_device	*xhci;
 	int			ret, irq;
 	int			prop_idx = 0;
 
 	/*
+	 * CRITICAL WARM-REBOOT FIX:
+	 * When switching roles or warm-rebooting, __dwc3_set_mode issues a
+	 * GCTL.CoreSoftReset and waits 100ms before calling dwc3_host_init. 1
+	 * The DWC3 PHY clocks might still be stabilizing. We must ensure the
+	 * modem reset sequence doesn't race with the PHY link training.
+	 */
+	dwc->reset_assert_us = 1000000;    /* Default 1s assert */
+	dwc->reset_deassert_us = 12000000; /* Extended to 12s for warm-reboot dirty state clearance */
+	device_property_read_u32(dwc->dev, "reset-assert-us", &dwc->reset_assert_us);
+	device_property_read_u32(dwc->dev, "reset-deassert-us", &dwc->reset_deassert_us);
+
+	/*
+	 * Use GPIOD_OUT_HIGH to force the pin to Logical 1 (Physical LOW safe state)
+	 * immediately upon request, eliminating any residual floating states from soft reboots.
+	 */
+	modem_rst_gpio = gpiod_get_optional(dwc->dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(modem_rst_gpio)) {
+		ret = PTR_ERR(modem_rst_gpio);
+		if (ret == -EPROBE_DEFER)
+			return ret;
+		dev_err(dwc->dev, "failed to get modem reset gpio: %d\n", ret);
+	} else if (modem_rst_gpio) {
+		dev_info(dwc->dev, "FM350-GL: Triggering synchronous HW reset...\n");
+
+		/*
+		 * Step 0: Pre-discharge & PHY Sync Wait.
+		 * Hold safe state for 500ms. This serves two purposes:
+		 * 1. Allows the modem's internal logic to completely settle.
+		 * 2. Gives the DWC3 PHY extra time to stabilize after CoreSoftReset.
+		 */
+		fsleep(500000);
+
+		/* Step 1: Assert reset (Logical 0 -> Physical HIGH) */
+		gpiod_set_value_cansleep(modem_rst_gpio, 0);
+		fsleep(dwc->reset_assert_us);
+
+		/* Step 2: Deassert reset (Logical 1 -> Physical LOW) */
+		gpiod_set_value_cansleep(modem_rst_gpio, 1);
+
+		/*
+		 * Step 3: Wait for firmware load and USB PHY link training.
+		 * Warm reboots require more time for the modem baseband to clear stale RAM.
+		 * During this 12s window, the modem will boot and initiate SS link training.
+		 * Because we waited 500ms in Step 0, the DWC3 PHY is guaranteed to be ready
+		 * to respond to the modem's LFPS (Low Frequency Periodic Signaling).
+		 */
+		msleep(DIV_ROUND_UP(dwc->reset_deassert_us, 1000));
+
+		dev_info(dwc->dev, "FM350-GL: Reset sequence completed.\n");
+		
+		/* Store in dwc context so it can be safely released on host exit */
+		dwc->modem_rst_gpio = modem_rst_gpio;
+	}
+
+	/*
 	 * Some platforms need to power off all Root hub ports immediately after DWC3 set to host
 	 * mode to avoid VBUS glitch happen when xhci get reset later.
 	 */
@@ -147,7 +206,8 @@
 	xhci = platform_device_alloc("xhci-hcd", PLATFORM_DEVID_AUTO);
 	if (!xhci) {
 		dev_err(dwc->dev, "couldn't allocate xHCI device\n");
-		return -ENOMEM;
+		ret = -ENOMEM;
+		goto err_put_gpio;
 	}
 
 	xhci->dev.parent	= dwc->dev;
@@ -218,5 +278,11 @@
 	return 0;
 err:
 	platform_device_put(xhci);
+err_put_gpio:
+	if (modem_rst_gpio) {
+		gpiod_set_value_cansleep(modem_rst_gpio, 1); /* Ensure safe state before release */
+		gpiod_put(modem_rst_gpio);
+		dwc->modem_rst_gpio = NULL; /* Prevent UAF on retry or teardown */
+	}
 	return ret;
 }
@@ -225,8 +291,20 @@
 {
 	if (dwc->sys_wakeup)
 		device_init_wakeup(&dwc->xhci->dev, false);
 
+	/*
+	 * Safely release the non-devm GPIO on host teardown.
+	 * This is called during role switch or system reboot via dwc3_core_exit_mode. 1
+	 * We MUST drive it to safe state before putting it back to the kernel pool,
+	 * otherwise the subsequent CoreSoftReset might cause the pin to float.
+	 */
+	if (dwc->modem_rst_gpio) {
+		gpiod_set_value_cansleep(dwc->modem_rst_gpio, 1); /* Force Physical LOW */
+		gpiod_put(dwc->modem_rst_gpio);
+		dwc->modem_rst_gpio = NULL;
+	}
+
 	dwc3_enable_susphy(dwc, true);
 	platform_device_unregister(dwc->xhci);
 	dwc->xhci = NULL;
 }
