+			 IS_ERR_OR_NULL(rkvdec->axi_clk) ? 0UL : clk_get_rate(rkvdec->axi_clk),
+			 IS_ERR_OR_NULL(rkvdec->axi_clk) ? ", axi clk missing" : "");
