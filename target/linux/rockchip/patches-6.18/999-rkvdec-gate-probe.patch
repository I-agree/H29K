+	if (rkvdec_bind_stage <= 0) {
+		dev_info(&pdev->dev, "rkvdec: bind gated (bind_stage=0), device left unbound\n");
+		return -ENODEV;
+	}
+
+	dev_info(&pdev->dev, "rkvdec: probe start (bind_stage=%d)\n", rkvdec_bind_stage);
+
 	variant = of_device_get_match_data(&pdev->dev);
 	if (!variant)
