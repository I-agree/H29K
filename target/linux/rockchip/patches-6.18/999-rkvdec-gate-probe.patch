+/*
+ * H29K debug gate: keep the decoder unbound at boot so a bad power/clock
+ * sequence can never break the boot path, then bisect at runtime via sysfs:
+ *   /sys/module/rockchip_vdec/parameters/bind_stage
+ *     0 = stay unbound (default)
+ *     1 = stop right after clocks are enabled
+ *     2 = stop right after the register windows are mapped
+ *     3 = stop right after the IRQ is requested
+ *     4 = stop right after the v4l2 devices are registered
+ *     5 = full probe
+ * then: echo <stage> > .../bind_stage
+ *       echo ff740000.video-codec > /sys/bus/platform/drivers/rkvdec/bind
+ */
+static int rkvdec_bind_stage;
+module_param_named(bind_stage, rkvdec_bind_stage, int, 0644);
+MODULE_PARM_DESC(bind_stage, "rkvdec bind gate: 0=unbound, 1..4=bisect stages");
+
