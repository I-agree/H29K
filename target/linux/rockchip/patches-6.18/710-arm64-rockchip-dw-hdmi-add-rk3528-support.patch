 #define RK3568_HDMI_SDAIN_MSK		BIT(15)
 #define RK3568_HDMI_SCLIN_MSK		BIT(14)
 
+/*
+ * RK3528 VO GRF HDMI control. The HDMI block's HPD input is not wired to the
+ * connector on RK3528 boards; the sink detect is fed from the SNKDET bit, which
+ * software has to mirror from the HPD GPIO (GPIO0_A2 by default).
+ */
+#define RK3528_VO_GRF_SOC_CON5		0x0014
+#define RK3528_HDMI_SDAIN_MSK		BIT(1)
+#define RK3528_HDMI_SCLIN_MSK		BIT(0)
+#define RK3528_HDMI_SNKDET		BIT(5)
+#define RK3528_HDMI_SNKDET_SEL		BIT(6)
+
+/* GPIO0 block, needed because GPIO0_A2 input path is gated by its data bit */
+#define RK3528_GPIO_SWPORT_DR_L		0x0000
+#define RK3528_GPIO0_A2_DR		BIT(2)
+
 /**
  * struct rockchip_hdmi_chip_data - splite the grf setting of kind of chips
  * @lcdsel_grf_reg: grf register offset of lcdc select
@@ -80,6 +98,9 @@
 	struct clk *grf_clk;
 	struct dw_hdmi *hdmi;
 	struct phy *phy;
+	struct gpio_desc *hpd_gpio;
+	void __iomem *gpio_base;
+	int hpd_irq;
 };
 
 static struct rockchip_hdmi *to_rockchip_hdmi(struct drm_encoder *encoder)
@@ -89,6 +110,50 @@
 	return container_of(rkencoder, struct rockchip_hdmi, encoder);
 }
 
+static void dw_hdmi_rk3528_hpd_update(struct rockchip_hdmi *hdmi)
+{
+	int level;
+
+	if (!hdmi->hpd_gpio)
+		return;
+
+	level = gpiod_get_value_cansleep(hdmi->hpd_gpio);
+	regmap_write(hdmi->regmap, RK3528_VO_GRF_SOC_CON5,
+		     FIELD_PREP_WM16(RK3528_HDMI_SNKDET, level ? 1 : 0));
+}
+
+static irqreturn_t dw_hdmi_rk3528_hpd_irq(int irq, void *data)
+{
+	dw_hdmi_rk3528_hpd_update(data);
+
+	return IRQ_HANDLED;
+}
+
+static void dw_hdmi_rk3528_hpd_gpio_init(struct rockchip_hdmi *hdmi)
+{
+	struct platform_device *pdev = to_platform_device(hdmi->dev);
+	struct resource *res;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!res)
+		return;
+
+	hdmi->gpio_base = devm_ioremap(hdmi->dev, res->start,
+				       resource_size(res));
+	if (IS_ERR(hdmi->gpio_base)) {
+		hdmi->gpio_base = NULL;
+		return;
+	}
+
+	/*
+	 * On RK3528 GPIO0_A2 doubles as the SNKDET pad: the input path is only
+	 * enabled while the matching output data bit is set, as done by the
+	 * vendor BSP. Without it gpiod_get_value() always reads 0.
+	 */
+	writel(FIELD_PREP_WM16(RK3528_GPIO0_A2_DR, RK3528_GPIO0_A2_DR),
+	       hdmi->gpio_base + RK3528_GPIO_SWPORT_DR_L);
+}
+
 static const struct dw_hdmi_mpll_config rockchip_mpll_cfg[] = {
 	{
 		30666000, {
@@ -497,6 +562,28 @@
