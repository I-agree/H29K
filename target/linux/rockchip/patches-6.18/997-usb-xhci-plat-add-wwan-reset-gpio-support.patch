+/*
+ * xhci_plat_wwan_reset - Control WWAN module reset via GPIO
+ * @priv: platform private data containing GPIO descriptor
+ * @assert: true to assert reset (drive active level), false to deassert
+ */
+static void xhci_plat_wwan_reset(struct xhci_plat_priv *priv, bool assert)
+{
+	if (!priv->reset_gpio)
+		return;
+
+	gpiod_set_value_cansleep(priv->reset_gpio, assert ? 1 : 0);
+}
+
+static void xhci_plat_wwan_deassert_work(struct work_struct *work)
+{
+	struct xhci_plat_priv *priv = container_of(work, struct xhci_plat_priv,
+						  wwan_deassert_work.work);
+	/* Deassert reset (drive GPIO inactive) */
+	xhci_plat_wwan_reset(priv, false);
+}
+
+static int xhci_plat_parse_wwan_reset(struct device *sysdev,
+				      struct xhci_plat_priv *priv)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(sysdev);
+
+	/*
+	 * The xhci-hcd device created by DWC3 uses a software_node and has
+	 * no of_node. The reset-gpios property lives in the parent DWC3
+	 * device tree node. Try sysdev's own fwnode first, then fall back
+	 * to the parent's of_node.
+	 */
+	priv->reset_gpio = devm_fwnode_gpiod_get(sysdev, fwnode, "reset",
+						 GPIOD_OUT_LOW, "wwan-reset");
+
+	if (!priv->reset_gpio && sysdev->parent && sysdev->parent->of_node) {
+		dev_dbg(sysdev, "reset-gpios not in swnode, trying parent of_node\n");
+		priv->reset_gpio = devm_fwnode_gpiod_get(
+			sysdev,
+			of_fwnode_handle(sysdev->parent->of_node),
+			"reset", GPIOD_OUT_LOW, "wwan-reset");
+	}
+
+	if (IS_ERR(priv->reset_gpio))
+		return dev_err_probe(sysdev, PTR_ERR(priv->reset_gpio),
+				     "failed to get wwan reset gpio\n");
+
+	if (priv->reset_gpio) {
+		struct fwnode_handle *prop_fwnode = dev_fwnode(sysdev);
+		unsigned long delay_jiffies;
+
+		/* Timing properties may also only exist in parent's of_node */
+		if (!fwnode_property_present(prop_fwnode, "reset-assert-us") &&
+		    sysdev->parent && sysdev->parent->of_node)
+			prop_fwnode = of_fwnode_handle(sysdev->parent->of_node);
+
+		fwnode_property_read_u32(prop_fwnode, "reset-assert-us",
+					 &priv->reset_assert_us);
+		fwnode_property_read_u32(prop_fwnode, "reset-deassert-us",
+					 &priv->reset_deassert_us);
+		dev_info(sysdev, "WWAN reset GPIO configured (assert=%uus, deassert=%uus [async via hotplug])\n",
+			 priv->reset_assert_us, priv->reset_deassert_us);
+
+		INIT_DELAYED_WORK(&priv->wwan_deassert_work,
+				  xhci_plat_wwan_deassert_work);
+
+		/*
+		 * GPIO is already asserted (LOW) via GPIOD_OUT_LOW.
+		 * Schedule async deassert after reset_assert_us to avoid
+		 * blocking probe. USB core will auto-enumerate the module
+		 * once it boots up after deassert.
+		 */
+		delay_jiffies = usecs_to_jiffies(priv->reset_assert_us);
+		schedule_delayed_work(&priv->wwan_deassert_work, delay_jiffies);
+	}
+
+	return 0;
+}
