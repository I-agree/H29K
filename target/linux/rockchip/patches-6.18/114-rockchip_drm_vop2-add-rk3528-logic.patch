--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
@@ -835,12 +835,14 @@
 	if (vop2->data->soc_id == 3566)
 		vop2_writel(vop2, RK3568_OTP_WIN_EN, 1);
 
-	if (vop2->version == VOP_VERSION_RK3588)
+	if (vop2->version == VOP_VERSION_RK3588 ||
+	    vop2->version == VOP_VERSION_RK3528)
 		rk3588_vop2_power_domain_enable_all(vop2);
 
-	if (vop2->version <= VOP_VERSION_RK3588) {
+	if (vop2->version <= VOP_VERSION_RK3588 ||
+	    vop2->version == VOP_VERSION_RK3528) {
 		vop2->old_layer_sel = vop2_readl(vop2, RK3568_OVL_LAYER_SEL);
 		vop2->old_port_sel = vop2_readl(vop2, RK3568_OVL_PORT_SEL);
 	}
 
 	vop2_writel(vop2, RK3568_REG_CFG_DONE, RK3568_REG_CFG_DONE__GLB_CFG_DONE_EN);
@@ -1264,6 +1266,11 @@
 		afbc_en ? "AFBC" : "", &yrgb_mst);
 
-	if (vop2->version > VOP_VERSION_RK3568) {
-		vop2_win_write(win, VOP2_WIN_AXI_BUS_ID, win->data->axi_bus_id);
+	if (vop2->version > VOP_VERSION_RK3568 &&
+	    vop2->version != VOP_VERSION_RK3528) {
+		vop2_win_write(win, VOP2_WIN_AXI_BUS_ID, win->data->axi_bus_id);
+	}
+
+	if (vop2->version > VOP_VERSION_RK3568 ||
+	    vop2->version == VOP_VERSION_RK3528) {
 		vop2_win_write(win, VOP2_WIN_AXI_YRGB_R_ID, win->data->axi_yrgb_r_id);
 		vop2_win_write(win, VOP2_WIN_AXI_UV_R_ID, win->data->axi_uv_r_id);
@@ -1322,11 +1329,14 @@
 		 * On rk3566/8, this bit is auto gating enable,
 		 * but this function is not work well so we need
 		 * to disable it for these two platform.
-		 * On rk3588, and the following new soc(rk3528/rk3576),
-		 * this bit is gating disable, we should write 1 to
+		 * On rk3588, and the following new soc(rk3576),
+		 * this bit is gating disable, we should write 1 to
 		 * disable gating when enable afbc.
+		 * However, RK3528 hardware behavior matches RK3568,
+		 * we should write 0 to disable gating when enable afbc.
 		 */
-		if (vop2->version == VOP_VERSION_RK3568)
+		if (vop2->version == VOP_VERSION_RK3568 ||
+		    vop2->version == VOP_VERSION_RK3528)
 			vop2_win_write(win, VOP2_WIN_AFBC_AUTO_GATING_EN, 0);
 		else
 			vop2_win_write(win, VOP2_WIN_AFBC_AUTO_GATING_EN, 1);
@@ -1776,6 +1786,40 @@
 
+	/*
+	 * Switch DCLK parent to HDMI PHY clock safely.
+	 * This was previously done via assigned-clock-parents in DT, which
+	 * triggered early PHY register access before PD_VO was powered on,
+	 * causing SError bus hang. Moved here after pm_runtime_resume_and_get
+	 * ensures PD_VO is active.
+	 */
+	if (vop2->version == VOP_VERSION_RK3528 && vop2->pll_hdmiphy0) {
+		if (!vp->dclk_src)
+			vp->dclk_src = clk_get_parent(vp->dclk);
+
+		ret = clk_set_parent(vp->dclk, vop2->pll_hdmiphy0);
+		if (ret < 0)
+			drm_warn(vop2->drm,
+				 "Could not switch to HDMI PHY PLL: %d\n", ret);
+	}
+
 	clk_set_rate(vp->dclk, clock);
 
+	/*
+	 * This is unused and error init value for rk3528/rk3562 vp1, if less of this config,
+	 * vp1 can't display normally. Moved here to ensure stable clock and power domain
+	 * state after IOMMU attachment.
+	 */
+	if (vop2->version == VOP_VERSION_RK3528)
+		regmap_clear_bits(vop2->map, 0x700, GENMASK(5, 4));
+
+	/*
+	 * This is a workaround for RK3528/RK3562/RK3576:
+	 * The aclk pre auto gating function may disable the aclk
+	 * in some unexpected cases, which detected by hardware
+	 * automatically.
+	 */
+	if (vop2->version == VOP_VERSION_RK3528)
+		regmap_clear_bits(vop2->map, RK3568_SYS_AUTO_GATING_CTRL, BIT(4));
+
 	vop2_post_config(crtc);
 
 	vop2_cfg_done(vp);
