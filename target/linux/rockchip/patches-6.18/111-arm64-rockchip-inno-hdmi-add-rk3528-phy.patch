+	.recalc_rate = inno_hdmi_phy_rk3528_clk_recalc_rate,
+	.round_rate = inno_hdmi_phy_rk3528_clk_round_rate,
+	.set_rate = inno_hdmi_phy_rk3528_clk_set_rate,
+};
