#!/bin/sh
# H29K preinit 追踪 v5（纯观测版，不改变任何行为）
# 仓库路径 diag/05_h29k_trace → 由 diy-part1 铺到 files/lib/preinit/05_h29k_trace
# 做法：在 preinit_essential 阶段（此时 /lib/preinit/* 已全部 source 完）
#       给 preinit_main 的每个钩子前后插一对标记，精确看出卡在哪个钩子
# v5：A2/A3 直接确认 console 列表里还有没有 ttyGS0（验证"删 console=ttyGS0"是否生效）

exec 1>/dev/kmsg 2>&1

T() { echo "<6>H29K-TRACE: $*"; }

T "A0 sourced pid=$$ PREINIT=$PREINIT INITRAMFS=$INITRAMFS"
T "A1 cmdline: $(cat /proc/cmdline 2>/dev/null)"
T "A2 consoles(active): $(cat /sys/class/tty/console/active 2>/dev/null)"
if [ -c /dev/ttyGS0 ]; then
	T "A3 ttyGS0: 存在（不该存在，会卡住 failsafe）"
else
	T "A3 ttyGS0: 不存在（正确）"
fi

# ---- mount_root 前后打点（fstools 挂 overlay 的入口）----
mount_root() {
	T "B0 mount_root enter: $*"
	/sbin/mount_root "$@"
	rc=$?
	T "B1 mount_root exit rc=$rc"
	return $rc
}

# ---- 阶段钩子 ----
h29k_tr_main() { T "C1 hit"; }

h29k_tr_essential() {
	T "C0 hook preinit_essential"
	T "C0a hooks(before): $preinit_main_hook"
	_list=""
	for _h in $preinit_main_hook; do
		eval "b4_$_h() { T \"E> $_h 进入\"; }"
		eval "af_$_h() { T \"E< $_h 返回\"; }"
		_list="${_list:+$_list }b4_$_h $_h af_$_h"
	done
	preinit_main_hook="$_list"	# 同一 shell 直接赋值即可，不必 export -n
	T "C0b hooks(after): $preinit_main_hook"
}

boot_hook_add preinit_essential h29k_tr_essential
boot_hook_add preinit_main h29k_tr_main

# ---- 现场扫描：用户态进程 + 内核栈 + 挂载表 ----
scan() {
	L="$1"
	T "=== scan[$L] userspace ==="
	for d in /proc/[0-9]*; do
		p=${d#/proc/}
		cm=$(cat "$d/comm" 2>/dev/null) || continue
		cl=$(tr -d '\000' < "$d/cmdline" 2>/dev/null)
		[ -n "$cl" ] || continue
		cl=$(printf '%.100s' "$cl")
		st=$(sed -n 's/^State:[[:space:]]*//p' "$d/status" 2>/dev/null)
		pp=$(sed -n 's/^PPid:[[:space:]]*//p' "$d/status" 2>/dev/null)
		wc=$(cat "$d/wchan" 2>/dev/null)
		T "u pid=$p ppid=$pp state=${st%% *} wchan=$wc cmd=$cl"
	done
	T "=== scan[$L] stacks ==="
	for d in /proc/[0-9]*; do
		p=${d#/proc/}
		cl=$(tr -d '\000' < "$d/cmdline" 2>/dev/null)
		[ -n "$cl" ] || continue
		cat "$d/stack" 2>/dev/null | while read -r s; do T "stk $p $s"; done
	done
	T "=== scan[$L] mounts ==="
	while read -r m; do T "mt $m"; done < /proc/mounts
	T "=== scan[$L] end ==="
}

# ---- 心跳（每 5 秒，共 150 秒），中间做两次扫描 ----
(
	i=0
	while [ $i -lt 30 ]; do
		sleep 5
		i=$((i+1))
		case $i in
			6|18) scan "$((i*5))s" ;;
		esac
		T "heartbeat $i"
	done
) &

T "watchdog started"
