#!/bin/sh
# H29K preinit 追踪 v6（降噪版，纯观测，不改变任何行为）
# 仓库路径 diag/05_h29k_trace → 由 diy-part1 铺到 files/lib/preinit/05_h29k_trace
# 相比 v5：
#   - 删掉 5 秒心跳 ×30 和 90s/30s 两次全进程扫描（启动问题已定案，它们只会淹没 dmesg）
#   - 保留 A0~A3（cmdline / console 列表 / ttyGS0 存在性）与钩子进出打点
#   - 只在 120 秒还没进 run_init 时补一次「卡死现场」：wchan + 内核栈
# 全部输出走 /dev/kmsg，只出现在内核日志里，不影响 preinit 行为

exec 1>/dev/kmsg 2>&1

T() { echo "<6>H29K-TRACE: $*"; }

T "A0 sourced pid=$$ PREINIT=$PREINIT INITRAMFS=$INITRAMFS"
T "A1 cmdline: $(cat /proc/cmdline 2>/dev/null)"
T "A2 consoles(active): $(cat /sys/class/tty/console/active 2>/dev/null)"
if [ -c /dev/ttyGS0 ]; then
	T "A3 ttyGS0: 存在（不该存在，会卡住 failsafe）"
else
	T "A3 ttyGS0: 不存在（正确）"
fi

# ---- mount_root 前后打点（fstools 挂 overlay 的入口）----
mount_root() {
	T "B0 mount_root enter: $*"
	/sbin/mount_root "$@"
	rc=$?
	T "B1 mount_root exit rc=$rc"
	return $rc
}

# ---- 阶段钩子 ----
h29k_tr_main() { T "C1 hit"; }

h29k_tr_essential() {
	T "C0 hook preinit_essential"
	_list=""
	for _h in $preinit_main_hook; do
		eval "b4_$_h() { T \"E> $_h 进入\"; }"
		eval "af_$_h() { [ \"$_h\" = run_init ] && touch /tmp/.h29k_runinit; T \"E< $_h 返回\"; }"
		_list="${_list:+$_list }b4_$_h $_h af_$_h"
	done
	preinit_main_hook="$_list"
}

boot_hook_add preinit_essential h29k_tr_essential
boot_hook_add preinit_main h29k_tr_main

# ---- 唯一的兜底：120 秒还没进 run_init 就把卡死现场打一次 ----
(
	sleep 120
	if [ ! -e /tmp/.h29k_runinit ]; then
		T "STALL120 wchan=$(cat /proc/$$/wchan 2>/dev/null)"
		while read -r s; do T "stk $$ $s"; done < /proc/$$/stack 2>/dev/null
		T "STALL120 end"
	fi
) &

T "v6 armed"
