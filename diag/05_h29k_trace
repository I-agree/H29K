#!/bin/sh
# H29K preinit 追踪 v7（纯观测：不改 hook 成员、不改执行顺序、不改任何行为）
#
# 与 v6 的关键区别：
#   v6 靠「重写 preinit_main_hook」来插桩，实测把中间的 6 个钩子丢了
#   （preinit_ip / pi_indicate_preinit / failsafe_wait / run_failsafe_hook /
#     indicate_regular_preinit / initramfs_test），还把追加的 h29k_tr_main 一起吞掉，
#   所以抓包里 7.337→11.955 那段 4.6s 完全黑、C1 从没出现。
#
#   v7 改成「忠实复刻 /lib/functions/preinit.sh 的 boot_run_hook 并只加打点」：
#   链表一个字符都不动，覆盖率 100%，每个钩子都有 进入/返回/rc 和所属阶段。
#
# 全部输出走 /dev/kmsg，所以在 dmesg / netconsole 抓包里都能看到（带内核时间戳）。

# 把本脚本的 stdout/stderr 也接进内核日志，这样钩子自身的 echo 也会出现在抓包里
# （v6 就是这么干的，实机验证过不影响启动）
exec 1>/dev/kmsg 2>&1

T() { echo "<6>H29K-TRACE: $*"; }

# ---- A 段：环境自检（只打一次）----
T "A0 pid=$$ PREINIT=${PREINIT} INITRAMFS=${INITRAMFS}"
T "A1 cmdline: $(cat /proc/cmdline 2>/dev/null)"
T "A2 console active: $(cat /sys/class/tty/console/active 2>/dev/null)"
if [ -c /dev/ttyGS0 ]; then
	T "A3 ttyGS0 存在（危险：failsafe 会卡在 n_tty_write）"
else
	T "A3 ttyGS0 不存在（正常）"
fi

# ---- boot_run_hook 复刻（语义与上游完全一致，仅多三处打点）----
boot_run_hook() {
	local hook="$1"
	local func

	eval "h29k_q=\$${hook}_hook"
	T "STAGE $hook 队列: ${h29k_q:-<空>}"

	while boot_hook_shift "$hook" func; do
		local ran; eval "ran=\$PI_RAN_$func"
		if [ -n "$ran" ]; then
			T "== $hook/$func 已在更早阶段跑过，跳过"
			continue
		fi
		export -n "PI_RAN_$func=1"
		[ "$func" = run_init ] && touch /tmp/.h29k_runinit
		T ">> $hook/$func"
		$func "$1" "$2"
		h29k_rc=$?
		T "<< $hook/$func rc=$h29k_rc"
	done
}

# ---- 唯一的兜底：120s 还没进 run_init，把卡死现场打一次 ----
(
	sleep 120
	[ -e /tmp/.h29k_runinit ] && exit 0
	T "STALL120 wchan=$(cat /proc/$$/wchan 2>/dev/null)"
	while read -r s; do T "stk $s"; done < /proc/$$/stack 2>/dev/null
	T "STALL120 end"
) &

T "v7 armed"
